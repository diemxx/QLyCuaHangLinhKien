<UserControl x:Class="ComputerStore_WPF.Views.UserControls.NhanVienUC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:ComputerStore_WPF.Converters"
             Background="#E8F1EC">
    <UserControl.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="FormLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#557A6F"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>
        <Style x:Key="FormInput" TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Background" Value="#F8FAF9"/>
            <Setter Property="Foreground" Value="#2C3D38"/>
            <Setter Property="BorderBrush" Value="#C2D6CE"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Tiêu đề -->
        <TextBlock Grid.Row="0" Text="QUẢN LÝ NHÂN VIÊN VÀ PHÂN QUYỀN" FontSize="22" FontWeight="Bold" 
                   Foreground="#2C3D38" Margin="0,0,0,15"/>

        <!-- Form nhập liệu -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#C2D6CE" BorderThickness="1" 
                CornerRadius="12" Padding="20" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="THÔNG TIN NHÂN VIÊN" FontSize="14" FontWeight="Bold" Foreground="#2C3D38" Margin="0,0,0,12"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Dòng 1 -->
                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,10">
                        <TextBlock Text="Họ và tên *" Style="{StaticResource FormLabel}"/>
                        <TextBox Text="{Binding HoTen, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormInput}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,10">
                        <TextBlock Text="Ngày sinh" Style="{StaticResource FormLabel}"/>
                        <DatePicker SelectedDate="{Binding NgaySinh}" Height="32" Background="#F8FAF9" BorderBrush="#C2D6CE"/>
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="4" Margin="0,0,0,10">
                        <TextBlock Text="Số điện thoại" Style="{StaticResource FormLabel}"/>
                        <TextBox Text="{Binding SDT, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormInput}"/>
                    </StackPanel>

                    <!-- Dòng 2 -->
                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,10">
                        <TextBlock Text="Email" Style="{StaticResource FormLabel}"/>
                        <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormInput}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,10">
                        <TextBlock Text="Tên đăng nhập *" Style="{StaticResource FormLabel}"/>
                        <TextBox Text="{Binding TenDangNhap, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormInput}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="4" Margin="0,0,0,10">
                        <TextBlock Text="Vai trò (phân quyền) *" Style="{StaticResource FormLabel}"/>
                        <ComboBox ItemsSource="{Binding DSVaiTro}" SelectedItem="{Binding SelectedVaiTro}"
                                  DisplayMemberPath="TenVaiTro" Height="32" FontSize="13" Background="#F8FAF9"
                                  BorderBrush="#C2D6CE" Padding="8,5"/>
                    </StackPanel>

                    <!-- Dòng 3 -->
                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,10">
                        <TextBlock Text="Trạng thái" Style="{StaticResource FormLabel}"/>
                        <ComboBox ItemsSource="{Binding DSTrangThai}" SelectedItem="{Binding TrangThai}"
                                  Height="32" FontSize="13" Background="#F8FAF9" BorderBrush="#C2D6CE" Padding="8,5"/>
                    </StackPanel>
                </Grid>

                <!-- Nút chức năng -->
                <WrapPanel Margin="0,8,0,0">
                    <Button Content="THÊM MỚI" Command="{Binding ThemCommand}" Style="{StaticResource ActionButton}" Background="#2A9D8F"/>
                    <Button Content="CẬP NHẬT" Command="{Binding SuaCommand}" Style="{StaticResource ActionButton}" Background="#4A7C6B"/>
                    <Button Content="KHÓA TÀI KHOẢN" Command="{Binding XoaCommand}" Style="{StaticResource ActionButton}" Background="#E07A5F"/>
                    <Button Content="ĐẶT LẠI MẬT KHẨU" Command="{Binding DatLaiMatKhauCommand}" Style="{StaticResource ActionButton}" Background="#D48166"/>
                    <Button Content="LÀM MỚI" Command="{Binding LamMoiCommand}" Style="{StaticResource ActionButton}" Background="#6B8E85"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- Phần dưới: Tìm kiếm + DataGrid -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Tìm kiếm -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Tìm kiếm:" Foreground="#557A6F" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="300" Height="32" FontSize="13" 
                         Padding="8,5" Background="#FFFFFF" BorderBrush="#C2D6CE" BorderThickness="1"/>
            </StackPanel>

            <!-- Bảng danh sách nhân viên -->
            <DataGrid Grid.Row="1" ItemsSource="{Binding DSNhanVien}" SelectedItem="{Binding SelectedNhanVien}"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      Background="#FFFFFF" Foreground="#2C3D38" RowBackground="#FFFFFF" 
                      AlternatingRowBackground="#F4F8F6" BorderBrush="#C2D6CE" BorderThickness="1" 
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E0EAE5" HeadersVisibility="Column"
                      SelectionMode="Single" CanUserSortColumns="True">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#4A7C6B"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="Padding" Value="10,8"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Mã NV" Binding="{Binding MaNV}" Width="70"/>
                    <DataGridTextColumn Header="Họ và tên" Binding="{Binding HoTen}" Width="*"/>
                    <DataGridTextColumn Header="Ngày sinh" Binding="{Binding NgaySinh, StringFormat='{}{0:dd/MM/yyyy}'}" Width="100"/>
                    <DataGridTextColumn Header="SĐT" Binding="{Binding SDT}" Width="110"/>
                    <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="170"/>
                    <DataGridTextColumn Header="Tên đăng nhập" Binding="{Binding TenDangNhap}" Width="120"/>
                    <DataGridTextColumn Header="Vai trò" Binding="{Binding TenVaiTro}" Width="120"/>
                    <DataGridTextColumn Header="Trạng thái" Binding="{Binding TrangThai}" Width="100">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TrangThai}" Value="Đã khóa">
                                        <Setter Property="Foreground" Value="#E07A5F"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding TrangThai}" Value="Hoạt động">
                                        <Setter Property="Foreground" Value="#2A9D8F"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</UserControl>
