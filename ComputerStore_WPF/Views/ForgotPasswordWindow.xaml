<Window x:Class="ComputerStore_WPF.Views.ForgotPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quên mật khẩu - Computer Store"
        Height="500" Width="440"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#E8F1EC">
    <Window.Resources>
        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Background" Value="#F8FAF9"/>
            <Setter Property="Foreground" Value="#2C3D38"/>
            <Setter Property="BorderBrush" Value="#C2D6CE"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CaretBrush" Value="#2A9D8F"/>
        </Style>
        <Style x:Key="PasswordStyle" TargetType="PasswordBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Background" Value="#F8FAF9"/>
            <Setter Property="Foreground" Value="#2C3D38"/>
            <Setter Property="BorderBrush" Value="#C2D6CE"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CaretBrush" Value="#2A9D8F"/>
        </Style>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#557A6F"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="ErrorStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E07A5F"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="2,2,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid>
        <Border Background="#FFFFFF" CornerRadius="15" Margin="25" Padding="30">
            <Border.Effect>
                <DropShadowEffect Color="#98B8AD" BlurRadius="25" ShadowDepth="5" Opacity="0.3"/>
            </Border.Effect>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="🔑" FontSize="38" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <TextBlock Text="QUÊN MẬT KHẨU" FontSize="19" FontWeight="Bold"
                           Foreground="#2A9D8F" HorizontalAlignment="Center" Margin="0,0,0,3"/>
                <TextBlock Text="Nhập thông tin để đặt lại mật khẩu" FontSize="11"
                           Foreground="#6B8E85" HorizontalAlignment="Center" Margin="0,0,0,22"/>

                <!-- Bước 1: Xác minh tài khoản -->
                <StackPanel x:Name="pnlStep1" Visibility="{Binding IsStep1, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Tên đăng nhập *" Style="{StaticResource LabelStyle}"/>
                    <TextBox x:Name="txtTenDangNhap" Style="{StaticResource InputStyle}"
                             Text="{Binding TenDangNhap, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,2"/>
                    <TextBlock Text="{Binding TenDangNhapError}" Style="{StaticResource ErrorStyle}" Margin="0,0,0,12"/>

                    <TextBlock Text="Email đã đăng ký *" Style="{StaticResource LabelStyle}"/>
                    <TextBox x:Name="txtEmail" Style="{StaticResource InputStyle}"
                             Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,2"/>
                    <TextBlock Text="{Binding EmailError}" Style="{StaticResource ErrorStyle}" Margin="0,0,0,12"/>

                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#E07A5F" FontSize="12"
                               FontWeight="Medium" TextWrapping="Wrap" HorizontalAlignment="Center"
                               Margin="0,0,0,10"/>

                    <Button Content="XÁC MINH TÀI KHOẢN" Height="42" FontSize="13" FontWeight="Bold"
                            Foreground="White" Cursor="Hand" Margin="0,4,0,10"
                            Click="BtnVerify_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#2A9D8F"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="10">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#21867A"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

                <!-- Bước 2: Đặt lại mật khẩu -->
                <StackPanel x:Name="pnlStep2" Visibility="{Binding IsStep2, Converter={StaticResource BoolToVis}}">
                    <Border Background="#F0FAF8" CornerRadius="8" Padding="12" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="✅ " FontSize="14"/>
                            <TextBlock Text="{Binding VerifiedInfo}" Foreground="#2A9D8F"
                                       FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Mật khẩu mới *" Style="{StaticResource LabelStyle}"/>
                    <PasswordBox x:Name="txtMatKhauMoi" Style="{StaticResource PasswordStyle}"
                                 Margin="0,0,0,2"
                                 PasswordChanged="TxtMatKhauMoi_PasswordChanged"/>
                    <TextBlock Text="{Binding MatKhauMoiError}" Style="{StaticResource ErrorStyle}" Margin="0,0,0,4"/>
                    <TextBlock Text="(Tối thiểu 8 ký tự, bao gồm chữ hoa, chữ thường và số)"
                               Foreground="#9CAEA8" FontSize="10" Margin="0,0,0,12" TextWrapping="Wrap"/>

                    <TextBlock Text="Xác nhận mật khẩu mới *" Style="{StaticResource LabelStyle}"/>
                    <PasswordBox x:Name="txtXacNhanMatKhau" Style="{StaticResource PasswordStyle}"
                                 Margin="0,0,0,2"
                                 PasswordChanged="TxtXacNhanMatKhau_PasswordChanged"/>
                    <TextBlock Text="{Binding XacNhanMatKhauError}" Style="{StaticResource ErrorStyle}" Margin="0,0,0,12"/>

                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#E07A5F" FontSize="12"
                               FontWeight="Medium" TextWrapping="Wrap" HorizontalAlignment="Center"
                               Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding SuccessMessage}" Foreground="#2A9D8F" FontSize="12"
                               FontWeight="Medium" TextWrapping="Wrap" HorizontalAlignment="Center"
                               Margin="0,0,0,8"/>

                    <Button Content="ĐẶT LẠI MẬT KHẨU" Height="42" FontSize="13" FontWeight="Bold"
                            Foreground="White" Cursor="Hand" Margin="0,4,0,10"
                            Click="BtnResetPassword_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#2A9D8F"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="10">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#21867A"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

                <!-- Quay lại đăng nhập -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                    <TextBlock Text="Nhớ mật khẩu rồi? " Foreground="#6B8E85" FontSize="12"/>
                    <TextBlock Foreground="#2A9D8F" FontSize="12" FontWeight="SemiBold"
                               Cursor="Hand" TextDecorations="Underline"
                               MouseLeftButtonUp="BtnBackToLogin_Click">
                        <TextBlock.Text>Đăng nhập</TextBlock.Text>
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
