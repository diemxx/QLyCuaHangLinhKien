<Window x:Class="ComputerStore_WPF.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Đăng nhập - Quản lý cửa hàng linh kiện" 
        Height="650" Width="420" 
        WindowStartupLocation="CenterScreen" 
        ResizeMode="NoResize"
        Background="#E8F1EC">
    <Window.Resources>
        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Background" Value="#F8FAF9"/>
            <Setter Property="Foreground" Value="#2C3D38"/>
            <Setter Property="BorderBrush" Value="#C2D6CE"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CaretBrush" Value="#2A9D8F"/>
        </Style>

        <Style x:Key="PasswordStyle" TargetType="PasswordBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Background" Value="#F8FAF9"/>
            <Setter Property="Foreground" Value="#2C3D38"/>
            <Setter Property="BorderBrush" Value="#C2D6CE"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CaretBrush" Value="#2A9D8F"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Border Background="#FFFFFF" CornerRadius="15" Margin="30" Padding="30">
            <Border.Effect>
                <DropShadowEffect Color="#98B8AD" BlurRadius="25" ShadowDepth="5" Opacity="0.3"/>
            </Border.Effect>
            <StackPanel VerticalAlignment="Center">

                <TextBlock Text="💻" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                <TextBlock Text="COMPUTER STORE" FontSize="22" FontWeight="Bold" 
                           Foreground="#2A9D8F" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                <TextBlock Text="Nhóm 03 - Hệ thống quản lý cửa hàng linh kiện" FontSize="12" 
                           Foreground="#6B8E85" HorizontalAlignment="Center" Margin="0,0,0,25"/>

                <TextBlock Text="Tên đăng nhập" Foreground="#557A6F" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox x:Name="txtUsername" Style="{StaticResource InputStyle}" 
                         Text="{Binding TenDangNhap, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,15"/>

                <TextBlock Text="Mật khẩu" Foreground="#557A6F" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <PasswordBox x:Name="txtPassword" Style="{StaticResource PasswordStyle}" 
                             Margin="0,0,0,5" KeyDown="TxtPassword_KeyDown"/>

                <!-- Quên mật khẩu -->
                <TextBlock HorizontalAlignment="Right" Margin="0,0,0,8">
                    <Hyperlink Click="BtnForgotPassword_Click" Foreground="#2A9D8F" TextDecorations="None">
                        <Run Text="Quên mật khẩu?" FontSize="12"/>
                    </Hyperlink>
                </TextBlock>

                <TextBlock Text="{Binding ErrorMessage}" Foreground="#E07A5F" FontSize="12" FontWeight="Medium"
                           TextWrapping="Wrap" Margin="0,0,0,10" HorizontalAlignment="Center"/>

                <!-- Nút ĐĂNG NHẬP (filled) -->
                <Button Content="ĐĂNG NHẬP" Height="42" FontSize="14" FontWeight="Bold"
                        Foreground="White" Cursor="Hand" Margin="0,0,0,10"
                        Click="BtnLogin_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#2A9D8F"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="10">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#21867A"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Phân cách -->
                <Grid Margin="0,2,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Separator Grid.Column="0" Background="#C2D6CE" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="  hoặc  " Foreground="#9CAEA8" FontSize="11" VerticalAlignment="Center"/>
                    <Separator Grid.Column="2" Background="#C2D6CE" VerticalAlignment="Center"/>
                </Grid>

                <!-- Nút ĐĂNG KÝ TÀI KHOẢN MỚI (outlined) -->
                <Button Content="ĐĂNG KÝ TÀI KHOẢN MỚI" Height="42" FontSize="13" FontWeight="Bold"
                        Cursor="Hand" Margin="0,0,0,0"
                        Click="BtnRegister_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="White"/>
                            <Setter Property="Foreground" Value="#2A9D8F"/>
                            <Setter Property="BorderBrush" Value="#2A9D8F"/>
                            <Setter Property="BorderThickness" Value="2"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="8" Padding="10">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F0FAF8"/>
                                    <Setter Property="BorderBrush" Value="#21867A"/>
                                    <Setter Property="Foreground" Value="#21867A"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

            </StackPanel>
        </Border>
    </Grid>
</Window>