<UserControl x:Class="ComputerStore_WPF.Views.UserControls.SanPhamUC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:ComputerStore_WPF.Converters"
             Background="#E8F1EC">
    <UserControl.Resources>
        <conv:CurrencyFormatConverter x:Key="CurrencyFmt"/>
        <conv:StatusColorConverter x:Key="StatusColor"/>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="QUẢN LÝ SẢN PHẨM" FontSize="22" FontWeight="Bold" Foreground="#2C3D38" Margin="0,0,0,15"/>
            <WrapPanel>
                <TextBox Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}" 
                         Width="250" Height="35" FontSize="13" Padding="8,6" Margin="0,0,10,0"
                         Background="#FFFFFF" Foreground="#2C3D38" BorderBrush="#C2D6CE" CaretBrush="#2A9D8F">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>
                <ComboBox ItemsSource="{Binding DanhSachLoai}" SelectedValue="{Binding FilterLoai}" 
                          SelectedValuePath="MaLoai" DisplayMemberPath="TenLoai"
                          Width="180" Height="35" FontSize="13" Margin="0,0,10,0"
                          Background="#FFFFFF" BorderBrush="#C2D6CE"/>
                <Button Content="TÌM KIẾM" Command="{Binding SearchCommand}" 
                        Padding="15,0" Height="35" FontSize="12" FontWeight="Bold" 
                        Background="#2A9D8F" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                <Button Content="TẢI LẠI" Command="{Binding RefreshCommand}" 
                        Padding="15,0" Height="35" FontSize="12" FontWeight="Bold" 
                        Background="#4A7C6B" Foreground="White" BorderThickness="0" Cursor="Hand" Margin="10,0,0,0"/>
            </WrapPanel>
        </StackPanel>

        <DataGrid Grid.Row="2" ItemsSource="{Binding DanhSachSanPham}" SelectedItem="{Binding SelectedSanPham}"
                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                  Background="#FFFFFF" Foreground="#2C3D38" RowBackground="#FFFFFF" AlternatingRowBackground="#F4F8F6"
                  BorderBrush="#C2D6CE" BorderThickness="1" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E0EAE5"
                  HeadersVisibility="Column" CanUserAddRows="False">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#4A7C6B"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Padding" Value="8,6"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="FontSize" Value="12"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Mã SP" Binding="{Binding MaSP}" Width="70"/>
                <DataGridTextColumn Header="Tên sản phẩm" Binding="{Binding TenSP}" Width="*" MinWidth="200"/>
                <DataGridTextColumn Header="Loại" Binding="{Binding TenLoai}" Width="100"/>
                <DataGridTextColumn Header="NCC" Binding="{Binding TenNCC}" Width="130"/>
                <DataGridTextColumn Header="Giá nhập" Binding="{Binding GiaNhap, Converter={StaticResource CurrencyFmt}}" Width="120"/>
                <DataGridTextColumn Header="Giá bán" Binding="{Binding GiaBan, Converter={StaticResource CurrencyFmt}}" Width="120"/>
                <DataGridTemplateColumn Header="Tồn kho" Width="70">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding SoLuongTon}" FontWeight="Bold"
                                       Foreground="{Binding SoLuongTon, Converter={StaticResource StatusColor}}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Bảo hành" Binding="{Binding BaoHanh, StringFormat='{}{0} tháng'}" Width="80"/>
                <DataGridTextColumn Header="Trạng thái" Binding="{Binding TrangThai}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="3" Background="#FFFFFF" BorderBrush="#C2D6CE" BorderThickness="1" CornerRadius="12" Padding="15" Margin="0,15,0,0">
            <StackPanel>
                <TextBlock Text="THÔNG TIN SẢN PHẨM" FontSize="15" FontWeight="Bold" Foreground="#2A9D8F" Margin="0,0,0,12"/>
                <WrapPanel>
                    <StackPanel Margin="0,0,15,10">
                        <TextBlock Text="Mã SP" Foreground="#557A6F" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <DockPanel>
                            <Button Content="Tạo mã" DockPanel.Dock="Right" Width="55" Height="30" FontSize="10" FontWeight="Bold"
                                    Command="{Binding GenerateMaSPCommand}" Background="#6B8E85" Foreground="White" BorderThickness="0" Cursor="Hand" Margin="3,0,0,0"/>
                            <TextBox Text="{Binding MaSP}" Height="30" FontSize="12" Padding="5,4" 
                                     Background="#FFFFFF" Foreground="#2C3D38" BorderBrush="#C2D6CE" CaretBrush="#2A9D8F"/>
                        </DockPanel>
                    </StackPanel>
                    <StackPanel Margin="0,0,15,10">
                        <TextBlock Text="Tên sản phẩm" Foreground="#557A6F" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <TextBox Text="{Binding TenSP, UpdateSourceTrigger=PropertyChanged}" Width="250" Height="30" FontSize="12" Padding="5,4" 
                                 Background="#FFFFFF" Foreground="#2C3D38" BorderBrush="#C2D6CE" CaretBrush="#2A9D8F"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,15,10">
                        <TextBlock Text="Loại SP" Foreground="#557A6F" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <ComboBox ItemsSource="{Binding DanhSachLoai}" SelectedValue="{Binding MaLoai}" 
                                  SelectedValuePath="MaLoai" DisplayMemberPath="TenLoai" Width="150" Height="30" FontSize="12"
                                  Background="#FFFFFF" BorderBrush="#C2D6CE"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,15,10">
                        <TextBlock Text="Nhà cung cấp" Foreground="#557A6F" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <ComboBox ItemsSource="{Binding DanhSachNCC}" SelectedValue="{Binding MaNCC}" 
                                  SelectedValuePath="MaNCC" DisplayMemberPath="TenNCC" Width="180" Height="30" FontSize="12"
                                  Background="#FFFFFF" BorderBrush="#C2D6CE"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,15,10">
                        <TextBlock Text="Giá nhập" Foreground="#557A6F" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <TextBox Text="{Binding GiaNhap}" Width="120" Height="30" FontSize="12" Padding="5,4" 
                                 Background="#FFFFFF" Foreground="#2C3D38" BorderBrush="#C2D6CE" CaretBrush="#2A9D8F"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,15,10">
                        <TextBlock Text="Giá bán" Foreground="#557A6F" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <TextBox Text="{Binding GiaBan, UpdateSourceTrigger=PropertyChanged}" Width="120" Height="30" FontSize="12" Padding="5,4" 
                                 Background="#FFFFFF" Foreground="#2C3D38" BorderBrush="#C2D6CE" CaretBrush="#2A9D8F"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,15,10">
                        <TextBlock Text="Tồn kho" Foreground="#557A6F" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <TextBox Text="{Binding SoLuongTon}" Width="70" Height="30" FontSize="12" Padding="5,4" 
                                 Background="#FFFFFF" Foreground="#2C3D38" BorderBrush="#C2D6CE" CaretBrush="#2A9D8F"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,15,10">
                        <TextBlock Text="Bảo hành (tháng)" Foreground="#557A6F" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <TextBox Text="{Binding BaoHanh}" Width="100" Height="30" FontSize="12" Padding="5,4" 
                                 Background="#FFFFFF" Foreground="#2C3D38" BorderBrush="#C2D6CE" CaretBrush="#2A9D8F"/>
                    </StackPanel>
                </WrapPanel>

                <WrapPanel>
                    <StackPanel Margin="0,0,15,10">
                        <TextBlock Text="Thông số kỹ thuật" Foreground="#557A6F" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <TextBox Text="{Binding ThongSo}" Width="400" Height="30" FontSize="12" Padding="5,4" 
                                 Background="#FFFFFF" Foreground="#2C3D38" BorderBrush="#C2D6CE" CaretBrush="#2A9D8F"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,15,10">
                        <TextBlock Text="Hình ảnh" Foreground="#557A6F" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <DockPanel>
                            <Button Content="CHỌN ẢNH" DockPanel.Dock="Right" Width="80" Height="30" FontSize="11" FontWeight="Bold"
                                    Command="{Binding SelectImageCommand}" Background="#6B8E85" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                            <TextBox Text="{Binding HinhAnh}" Width="200" Height="30" FontSize="12" Padding="5,4" 
                                     Background="#FFFFFF" Foreground="#2C3D38" BorderBrush="#C2D6CE" CaretBrush="#2A9D8F"/>
                        </DockPanel>
                    </StackPanel>
                </WrapPanel>

                <WrapPanel Margin="0,10,0,0">
                    <Button Content="THÊM" Command="{Binding AddCommand}" 
                            Width="90" Height="32" FontSize="12" FontWeight="Bold" Background="#3A8970" Foreground="White" BorderThickness="0" Cursor="Hand" Margin="0,0,10,0"
                            Visibility="{Binding CanEdit, Converter={StaticResource BoolToVis}}"/>
                    <Button Content="SỬA" Command="{Binding UpdateCommand}" 
                            Width="90" Height="32" FontSize="12" FontWeight="Bold" Background="#2A9D8F" Foreground="White" BorderThickness="0" Cursor="Hand" Margin="0,0,10,0"
                            Visibility="{Binding CanEdit, Converter={StaticResource BoolToVis}}"/>
                    <Button Content="XÓA" Command="{Binding DeleteCommand}" 
                            Width="90" Height="32" FontSize="12" FontWeight="Bold" Background="#E07A5F" Foreground="White" BorderThickness="0" Cursor="Hand" Margin="0,0,10,0"
                            Visibility="{Binding CanDelete, Converter={StaticResource BoolToVis}}"/>
                    <Button Content="LÀM MỚI" Command="{Binding ClearCommand}" 
                            Width="100" Height="32" FontSize="12" FontWeight="Bold" Background="#9CAEA8" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                </WrapPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>