<UserControl x:Class="ComputerStore_WPF.Views.UserControls.ThongKeUC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:ComputerStore_WPF.Converters"
             Background="#E8F1EC">
    <UserControl.Resources>
        <conv:CurrencyFormatConverter x:Key="CurrencyFmt"/>
        <conv:StringToBrushConverter x:Key="StrToBrush"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <TextBlock Text="THỐNG KÊ DOANH THU" FontSize="22" FontWeight="Bold" Foreground="#2C3D38" Margin="0,0,0,15"/>

            <!-- ===== BỘ LỌC VÀ TỔNG QUAN ===== -->
            <Border Background="#FFFFFF" BorderBrush="#C2D6CE" BorderThickness="1" CornerRadius="12" Padding="15" Margin="0,0,0,15">
                <StackPanel>
                    <WrapPanel Margin="0,0,0,15">
                        <StackPanel Margin="0,0,15,0">
                            <TextBlock Text="Từ ngày" Foreground="#557A6F" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,3"/>
                            <DatePicker SelectedDate="{Binding TuNgay}" Width="150" Height="30" Background="#FFFFFF" BorderBrush="#C2D6CE"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,15,0">
                            <TextBlock Text="Đến ngày" Foreground="#557A6F" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,3"/>
                            <DatePicker SelectedDate="{Binding DenNgay}" Width="150" Height="30" Background="#FFFFFF" BorderBrush="#C2D6CE"/>
                        </StackPanel>

                        <Button Content="THỐNG KÊ" Command="{Binding ThongKeCommand}" 
                                Height="30" Padding="15,0" FontSize="12" FontWeight="Bold" 
                                Background="#2A9D8F" Foreground="White" BorderThickness="0" Cursor="Hand" VerticalAlignment="Bottom"/>

                        <Button Content="XUẤT BÁO CÁO" Command="{Binding ExportCommand}" 
                                Height="30" Padding="15,0" FontSize="12" FontWeight="Bold" 
                                Background="#4A7C6B" Foreground="White" BorderThickness="0" Cursor="Hand" VerticalAlignment="Bottom" Margin="8,0,0,0"/>
                    </WrapPanel>

                    <WrapPanel>
                        <Border Background="#4A7C6B" CornerRadius="8" Padding="15,10" Margin="0,0,15,0" MinWidth="200">
                            <StackPanel>
                                <TextBlock Text="TỔNG DOANH THU" Foreground="#C2D6CE" FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding DoanhThuText}" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#6B8E85" CornerRadius="8" Padding="15,10" Margin="0,0,15,0" MinWidth="150">
                            <StackPanel>
                                <TextBlock Text="SỐ HÓA ĐƠN" Foreground="#E0EAE5" FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding SoHoaDon}" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- ===== BIỂU ĐỒ TRÒN: DOANH THU THEO LOẠI SẢN PHẨM ===== -->
            <TextBlock Text="BIỂU ĐỒ DOANH THU THEO LOẠI SẢN PHẨM" FontSize="16" FontWeight="Bold" Foreground="#2C3D38" Margin="0,10,0,12"/>

            <Border Background="#FFFFFF" BorderBrush="#C2D6CE" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Canvas cho biểu đồ tròn loại SP -->
                    <Canvas x:Name="canvasLoaiSP" Grid.Column="0" Width="280" Height="280" Margin="0,0,20,0"/>

                    <!-- Chú thích biểu đồ loại SP -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="CHÚ THÍCH" FontSize="13" FontWeight="Bold" Foreground="#2C3D38" Margin="0,0,0,10"/>
                        <ItemsControl x:Name="icLegendLoaiSP" ItemsSource="{Binding DoanhThuTheoLoai}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,3">
                                        <Border Width="16" Height="16" CornerRadius="3" Margin="0,0,8,0"
                                                Background="{Binding MauSac, Converter={StaticResource StrToBrush}}"/>
                                        <TextBlock Text="{Binding HienThi}" FontSize="12" Foreground="#2C3D38" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding ThongBaoLoaiSP}" Foreground="#9CAEA8" FontSize="12" FontStyle="Italic" 
                                   TextWrapping="Wrap" Margin="0,5,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== BIỂU ĐỒ TRÒN: DOANH THU THEO THÁNG ===== -->
            <TextBlock FontSize="16" FontWeight="Bold" Foreground="#2C3D38" Margin="0,10,0,12">
                <Run Text="BIỂU ĐỒ DOANH THU THEO THÁNG NĂM "/>
                <Run Text="{Binding NamThongKe, Mode=OneWay}"/>
            </TextBlock>

            <Border Background="#FFFFFF" BorderBrush="#C2D6CE" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Canvas cho biểu đồ tròn theo tháng -->
                    <Canvas x:Name="canvasTheoThang" Grid.Column="0" Width="280" Height="280" Margin="0,0,20,0"/>

                    <!-- Chú thích biểu đồ theo tháng -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="CHÚ THÍCH" FontSize="13" FontWeight="Bold" Foreground="#2C3D38" Margin="0,0,0,10"/>
                        <ItemsControl ItemsSource="{Binding DoanhThuTheoThang}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,3">
                                        <Border Width="16" Height="16" CornerRadius="3" Margin="0,0,8,0"
                                                Background="{Binding MauSac, Converter={StaticResource StrToBrush}}"/>
                                        <TextBlock Text="{Binding HienThi}" FontSize="12" Foreground="#2C3D38" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding ThongBaoTheoThang}" Foreground="#9CAEA8" FontSize="12" FontStyle="Italic" 
                                   TextWrapping="Wrap" Margin="0,5,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== BẢNG CHI TIẾT HÓA ĐƠN ===== -->
            <TextBlock Text="CHI TIẾT DANH SÁCH HÓA ĐƠN" FontSize="16" FontWeight="Bold" Foreground="#2C3D38" Margin="0,10,0,12"/>

            <DataGrid ItemsSource="{Binding DSHoaDon}" AutoGenerateColumns="False" IsReadOnly="True"
                      Background="#FFFFFF" Foreground="#2C3D38" RowBackground="#FFFFFF" 
                      AlternatingRowBackground="#F4F8F6" BorderBrush="#C2D6CE" BorderThickness="1" 
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E0EAE5" HeadersVisibility="Column"
                      MaxHeight="400">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#4A7C6B"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="Padding" Value="10,8"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Mã HĐ" Binding="{Binding MaHDB}" Width="80"/>
                    <DataGridTextColumn Header="Nhân viên" Binding="{Binding TenNhanVien}" Width="150"/>
                    <DataGridTextColumn Header="Khách hàng" Binding="{Binding TenKhachHang}" Width="150"/>
                    <DataGridTextColumn Header="Ngày bán" Binding="{Binding NgayBan, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" Width="140"/>
                    <DataGridTextColumn Header="Tổng tiền" Binding="{Binding TongTien, Converter={StaticResource CurrencyFmt}}" Width="130"/>
                    <DataGridTextColumn Header="Giảm giá" Binding="{Binding GiamGia, Converter={StaticResource CurrencyFmt}}" Width="100"/>
                    <DataGridTextColumn Header="Thực tế" Binding="{Binding ThanhTienThucTe, Converter={StaticResource CurrencyFmt}}" Width="130"/>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>