<UserControl x:Class="ComputerStore_WPF.Views.UserControls.HoaDonUC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:ComputerStore_WPF.Converters"
             Background="#E8F1EC">
    <UserControl.Resources>
        <conv:CurrencyFormatConverter x:Key="CurrencyFmt"/>
        <Style x:Key="HeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#4A7C6B"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="QUẢN LÝ HÓA ĐƠN" FontSize="22" FontWeight="Bold" Foreground="#2C3D38" Margin="0,0,0,10"/>
            <WrapPanel>
                <Button Content="TẢI LẠI" Command="{Binding RefreshCommand}" 
                        Padding="15,0" Height="32" FontSize="12" FontWeight="Bold" 
                        Background="#2A9D8F" Foreground="White" BorderThickness="0" Cursor="Hand"/>
            </WrapPanel>
        </StackPanel>

        <TabControl Grid.Row="1" Background="#FFFFFF" BorderBrush="#C2D6CE" FontSize="13">
            <!-- TAB HÓA ĐƠN BÁN -->
            <TabItem Header="  📋 HÓA ĐƠN BÁN  " FontWeight="SemiBold">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="200"/>
                    </Grid.RowDefinitions>

                    <DataGrid Grid.Row="0" ItemsSource="{Binding DSHoaDonBan}" SelectedItem="{Binding SelectedHDB}"
                              AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                              Background="#FFFFFF" Foreground="#2C3D38" RowBackground="#FFFFFF" AlternatingRowBackground="#F4F8F6"
                              BorderBrush="#C2D6CE" BorderThickness="1" GridLinesVisibility="Horizontal" 
                              HorizontalGridLinesBrush="#E0EAE5" HeadersVisibility="Column" CanUserAddRows="False">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#2A9D8F"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="Padding" Value="8,5"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mã HĐB" Binding="{Binding MaHDB}" Width="80"/>
                            <DataGridTextColumn Header="Nhân viên" Binding="{Binding TenNhanVien}" Width="140"/>
                            <DataGridTextColumn Header="Khách hàng" Binding="{Binding TenKhachHang}" Width="140"/>
                            <DataGridTextColumn Header="Ngày bán" Binding="{Binding NgayBan, StringFormat='dd/MM/yyyy HH:mm'}" Width="140"/>
                            <DataGridTextColumn Header="Tổng tiền" Binding="{Binding TongTien, Converter={StaticResource CurrencyFmt}}" Width="130"/>
                            <DataGridTextColumn Header="Giảm giá" Binding="{Binding GiamGia, Converter={StaticResource CurrencyFmt}}" Width="110"/>
                            <DataGridTextColumn Header="Thực thu" Binding="{Binding ThanhTienThucTe, Converter={StaticResource CurrencyFmt}}" Width="130"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <WrapPanel Grid.Row="1" Margin="0,8">
                        <TextBlock Text="CHI TIẾT HÓA ĐƠN BÁN" FontSize="14" FontWeight="Bold" Foreground="#2A9D8F" 
                                   VerticalAlignment="Center" Margin="0,0,15,0"/>
                        <Button Content="XUẤT HÓA ĐƠN" Command="{Binding ExportHDBCommand}" 
                                Height="28" Padding="12,0" FontSize="11" FontWeight="Bold" 
                                Background="#3A8970" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                    </WrapPanel>

                    <DataGrid Grid.Row="2" ItemsSource="{Binding ChiTietHDB}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              Background="#FFFFFF" Foreground="#2C3D38" RowBackground="#FFFFFF" AlternatingRowBackground="#F4F8F6"
                              BorderBrush="#C2D6CE" BorderThickness="1" GridLinesVisibility="Horizontal" 
                              HorizontalGridLinesBrush="#E0EAE5" HeadersVisibility="Column" CanUserAddRows="False">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#6B8E85"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="Padding" Value="8,5"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mã SP" Binding="{Binding MaSP}" Width="70"/>
                            <DataGridTextColumn Header="Tên sản phẩm" Binding="{Binding TenSP}" Width="*"/>
                            <DataGridTextColumn Header="Số lượng" Binding="{Binding SoLuong}" Width="70"/>
                            <DataGridTextColumn Header="Đơn giá" Binding="{Binding DonGiaBan, Converter={StaticResource CurrencyFmt}}" Width="120"/>
                            <DataGridTextColumn Header="Thành tiền" Binding="{Binding ThanhTien, Converter={StaticResource CurrencyFmt}}" Width="130"/>
                            <DataGridTextColumn Header="Bảo hành đến" Binding="{Binding ThoiHanBaoHanh, StringFormat='dd/MM/yyyy'}" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- TAB HÓA ĐƠN NHẬP -->
            <TabItem Header="  📦 HÓA ĐƠN NHẬP  " FontWeight="SemiBold">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="200"/>
                    </Grid.RowDefinitions>

                    <DataGrid Grid.Row="0" ItemsSource="{Binding DSHoaDonNhap}" SelectedItem="{Binding SelectedHDN}"
                              AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                              Background="#FFFFFF" Foreground="#2C3D38" RowBackground="#FFFFFF" AlternatingRowBackground="#F4F8F6"
                              BorderBrush="#C2D6CE" BorderThickness="1" GridLinesVisibility="Horizontal" 
                              HorizontalGridLinesBrush="#E0EAE5" HeadersVisibility="Column" CanUserAddRows="False">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#4A7C6B"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="Padding" Value="8,5"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mã HDN" Binding="{Binding MaHDN}" Width="80"/>
                            <DataGridTextColumn Header="Nhân viên" Binding="{Binding TenNhanVien}" Width="140"/>
                            <DataGridTextColumn Header="Nhà cung cấp" Binding="{Binding TenNCC}" Width="160"/>
                            <DataGridTextColumn Header="Ngày nhập" Binding="{Binding NgayNhap, StringFormat='dd/MM/yyyy'}" Width="110"/>
                            <DataGridTextColumn Header="Tổng tiền" Binding="{Binding TongTien, Converter={StaticResource CurrencyFmt}}" Width="140"/>
                            <DataGridTextColumn Header="Ghi chú" Binding="{Binding GhiChu}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <WrapPanel Grid.Row="1" Margin="0,8">
                        <TextBlock Text="CHI TIẾT PHIẾU NHẬP" FontSize="14" FontWeight="Bold" Foreground="#4A7C6B" 
                                   VerticalAlignment="Center" Margin="0,0,15,0"/>
                        <Button Content="XUẤT PHIẾU NHẬP" Command="{Binding ExportHDNCommand}" 
                                Height="28" Padding="12,0" FontSize="11" FontWeight="Bold" 
                                Background="#4A7C6B" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                    </WrapPanel>

                    <DataGrid Grid.Row="2" ItemsSource="{Binding ChiTietHDN}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              Background="#FFFFFF" Foreground="#2C3D38" RowBackground="#FFFFFF" AlternatingRowBackground="#F4F8F6"
                              BorderBrush="#C2D6CE" BorderThickness="1" GridLinesVisibility="Horizontal" 
                              HorizontalGridLinesBrush="#E0EAE5" HeadersVisibility="Column" CanUserAddRows="False">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#6B8E85"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="Padding" Value="8,5"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mã SP" Binding="{Binding MaSP}" Width="70"/>
                            <DataGridTextColumn Header="Tên sản phẩm" Binding="{Binding TenSP}" Width="*"/>
                            <DataGridTextColumn Header="Số lượng" Binding="{Binding SoLuong}" Width="80"/>
                            <DataGridTextColumn Header="Đơn giá nhập" Binding="{Binding DonGiaNhap, Converter={StaticResource CurrencyFmt}}" Width="130"/>
                            <DataGridTextColumn Header="Thành tiền" Binding="{Binding ThanhTien, Converter={StaticResource CurrencyFmt}}" Width="130"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
