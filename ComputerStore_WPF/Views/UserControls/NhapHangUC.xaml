<UserControl x:Class="ComputerStore_WPF.Views.UserControls.NhapHangUC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:ComputerStore_WPF.Converters"
             Background="#E8F1EC">
    <UserControl.Resources>
        <conv:CurrencyFormatConverter x:Key="CurrencyFmt"/>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="QUẢN LÝ NHẬP HÀNG" FontSize="22" FontWeight="Bold" Foreground="#2C3D38" Margin="0,0,0,15"/>

        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#C2D6CE" BorderThickness="1" CornerRadius="12" Padding="15" Margin="0,0,0,15">
            <StackPanel>
                <WrapPanel>
                    <StackPanel Margin="0,0,15,8">
                        <TextBlock Text="Nhà cung cấp" Foreground="#557A6F" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <ComboBox ItemsSource="{Binding DSNCC}" SelectedValue="{Binding MaNCC}" SelectedValuePath="MaNCC" 
                                  DisplayMemberPath="TenNCC" Width="200" Height="30" Background="#FFFFFF" BorderBrush="#C2D6CE"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,15,8">
                        <TextBlock Text="Sản phẩm" Foreground="#557A6F" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <ComboBox ItemsSource="{Binding DSSanPham}" SelectedItem="{Binding SelectedSP}" 
                                  DisplayMemberPath="TenSP" Width="250" Height="30" Background="#FFFFFF" BorderBrush="#C2D6CE"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,15,8">
                        <TextBlock Text="Số lượng" Foreground="#557A6F" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <TextBox Text="{Binding SoLuongNhap}" Width="70" Height="30" FontSize="12" Padding="5,4" 
                                 Background="#FFFFFF" Foreground="#2C3D38" BorderBrush="#C2D6CE" CaretBrush="#2A9D8F"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,15,8">
                        <TextBlock Text="Đơn giá nhập" Foreground="#557A6F" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <TextBox Text="{Binding DonGiaNhap}" Width="120" Height="30" FontSize="12" Padding="5,4" 
                                 Background="#FFFFFF" Foreground="#2C3D38" BorderBrush="#C2D6CE" CaretBrush="#2A9D8F"/>
                    </StackPanel>

                    <Button Content="THÊM VÀO PHIẾU" Command="{Binding AddItemCommand}" 
                            Height="30" Padding="15,0" FontSize="12" FontWeight="Bold" Background="#3A8970" 
                            Foreground="White" BorderThickness="0" Cursor="Hand" VerticalAlignment="Bottom" Margin="0,0,0,8"/>
                </WrapPanel>

                <StackPanel Margin="0,5,0,0">
                    <TextBlock Text="Ghi chú" Foreground="#557A6F" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,3"/>
                    <TextBox Text="{Binding GhiChu}" Height="30" FontSize="12" Padding="5,4" 
                             Background="#FFFFFF" Foreground="#2C3D38" BorderBrush="#C2D6CE" CaretBrush="#2A9D8F"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <DataGrid Grid.Row="2" ItemsSource="{Binding ChiTietNhap}" AutoGenerateColumns="False" IsReadOnly="True"
                  Background="#FFFFFF" Foreground="#2C3D38" RowBackground="#FFFFFF" 
                  AlternatingRowBackground="#F4F8F6" BorderBrush="#C2D6CE" BorderThickness="1" 
                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E0EAE5" HeadersVisibility="Column">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#4A7C6B"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Padding" Value="8,5"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Mã SP" Binding="{Binding MaSP}" Width="80"/>
                <DataGridTextColumn Header="Tên SP" Binding="{Binding TenSP}" Width="*"/>
                <DataGridTextColumn Header="Số lượng" Binding="{Binding SoLuong}" Width="80"/>
                <DataGridTextColumn Header="Đơn giá nhập" Binding="{Binding DonGiaNhap, Converter={StaticResource CurrencyFmt}}" Width="130"/>
                <DataGridTextColumn Header="Thành tiền" Binding="{Binding ThanhTien, Converter={StaticResource CurrencyFmt}}" Width="130"/>
                <DataGridTemplateColumn Header="" Width="45">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Xóa" Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                    CommandParameter="{Binding}" Background="Transparent" Foreground="#E07A5F" 
                                    BorderThickness="0" Cursor="Hand" FontWeight="SemiBold"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <DockPanel Grid.Row="3" Margin="0,15,0,0">
            <TextBlock Text="{Binding TongTien, Converter={StaticResource CurrencyFmt}, StringFormat='Tổng tiền: {0}'}" 
                       FontSize="20" FontWeight="Bold" Foreground="#E07A5F" VerticalAlignment="Center"/>
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button Content="LƯU PHIẾU NHẬP" Command="{Binding CreateOrderCommand}" 
                        Height="38" Padding="20,0" FontSize="13" FontWeight="Bold" 
                        Background="#2A9D8F" Foreground="White" BorderThickness="0" Cursor="Hand" Margin="0,0,10,0"/>
                <Button Content="HỦY PHIẾU" Command="{Binding ClearCommand}" 
                        Height="38" Padding="20,0" FontSize="13" FontWeight="Bold" 
                        Background="#E07A5F" Foreground="White" BorderThickness="0" Cursor="Hand"/>
            </StackPanel>
        </DockPanel>

    </Grid>
</UserControl>