<UserControl x:Class="ComputerStore_WPF.Views.UserControls.KhachHangUC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#E8F1EC">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="QUẢN LÝ KHÁCH HÀNG" FontSize="22" FontWeight="Bold" Foreground="#2C3D38" Margin="0,0,0,15"/>

        <DataGrid x:Name="dgKhachHang" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                  Background="#FFFFFF" Foreground="#2C3D38" RowBackground="#FFFFFF" 
                  AlternatingRowBackground="#F4F8F6" BorderBrush="#C2D6CE" BorderThickness="1" 
                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E0EAE5" HeadersVisibility="Column">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#4A7C6B"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Padding" Value="8,5"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Mã KH" Binding="{Binding MaKH}" Width="70"/>
                <DataGridTextColumn Header="Tên khách hàng" Binding="{Binding TenKH}" Width="*"/>
                <DataGridTextColumn Header="SĐT" Binding="{Binding SDT}" Width="120"/>
                <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="180"/>
                <DataGridTextColumn Header="Địa chỉ" Binding="{Binding DiaChi}" Width="200"/>
                <DataGridTextColumn Header="Điểm tích lũy" Binding="{Binding DiemTichLuy}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#C2D6CE" BorderThickness="1" CornerRadius="12" Padding="15" Margin="0,15,0,0">
            <StackPanel>
                <TextBlock Text="THÊM KHÁCH HÀNG MỚI" FontSize="15" FontWeight="Bold" Foreground="#2A9D8F" Margin="0,0,0,12"/>
                <WrapPanel>
                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Text="Mã KH" Foreground="#557A6F" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <TextBox x:Name="txtMaKH" Width="80" Height="30" FontSize="12" Padding="5,4" 
                                 Background="#FFFFFF" Foreground="#2C3D38" BorderBrush="#C2D6CE" CaretBrush="#2A9D8F"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Text="Tên KH" Foreground="#557A6F" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <TextBox x:Name="txtTenKH" Width="180" Height="30" FontSize="12" Padding="5,4" 
                                 Background="#FFFFFF" Foreground="#2C3D38" BorderBrush="#C2D6CE" CaretBrush="#2A9D8F"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Text="SĐT" Foreground="#557A6F" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <TextBox x:Name="txtSDT" Width="120" Height="30" FontSize="12" Padding="5,4" 
                                 Background="#FFFFFF" Foreground="#2C3D38" BorderBrush="#C2D6CE" CaretBrush="#2A9D8F"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Text="Email" Foreground="#557A6F" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <TextBox x:Name="txtEmail" Width="180" Height="30" FontSize="12" Padding="5,4" 
                                 Background="#FFFFFF" Foreground="#2C3D38" BorderBrush="#C2D6CE" CaretBrush="#2A9D8F"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Text="Địa chỉ" Foreground="#557A6F" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <TextBox x:Name="txtDiaChi" Width="250" Height="30" FontSize="12" Padding="5,4" 
                                 Background="#FFFFFF" Foreground="#2C3D38" BorderBrush="#C2D6CE" CaretBrush="#2A9D8F"/>
                    </StackPanel>

                    <Button x:Name="btnThemKH" Content="THÊM KHÁCH HÀNG" Click="BtnThemKH_Click" 
                            Height="30" Padding="15,0" FontSize="12" FontWeight="Bold" 
                            Background="#2A9D8F" Foreground="White" BorderThickness="0" 
                            Cursor="Hand" VerticalAlignment="Bottom" Margin="0,0,0,8"/>
                </WrapPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>