<UserControl x:Class="ComputerStore_WPF.Views.UserControls.TongQuanUC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#E8F1EC">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="30">
            <TextBlock Text="TỔNG QUAN HỆ THỐNG" FontSize="24" FontWeight="Bold" Foreground="#2C3D38" Margin="0,0,0,25"/>

            <!-- ===== CÁC THẺ THỐNG KÊ NHANH ===== -->
            <WrapPanel>
                <Border Background="#FFFFFF" BorderBrush="#C2D6CE" BorderThickness="1" CornerRadius="12" Padding="25" Margin="0,0,15,15" MinWidth="250">
                    <StackPanel>
                        <TextBlock Text="Tổng sản phẩm" Foreground="#557A6F" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock x:Name="txtTongSP" Text="--" FontSize="32" FontWeight="Bold" Foreground="#2A9D8F" Margin="0,5,0,0"/>
                        <TextBlock Text="sản phẩm đang kinh doanh" Foreground="#9CAEA8" FontSize="11"/>
                    </StackPanel>
                </Border>

                <Border Background="#FFFFFF" BorderBrush="#C2D6CE" BorderThickness="1" CornerRadius="12" Padding="25" Margin="0,0,15,15" MinWidth="250">
                    <StackPanel>
                        <TextBlock Text="Hóa đơn hôm nay" Foreground="#557A6F" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock x:Name="txtHoaDon" Text="--" FontSize="32" FontWeight="Bold" Foreground="#3A8970" Margin="0,5,0,0"/>
                        <TextBlock Text="hóa đơn bán hàng" Foreground="#9CAEA8" FontSize="11"/>
                    </StackPanel>
                </Border>

                <Border Background="#FFFFFF" BorderBrush="#C2D6CE" BorderThickness="1" CornerRadius="12" Padding="25" Margin="0,0,15,15" MinWidth="250">
                    <StackPanel>
                        <TextBlock Text="Doanh thu hôm nay" Foreground="#557A6F" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock x:Name="txtDoanhThu" Text="--" FontSize="28" FontWeight="Bold" Foreground="#D48166" Margin="0,5,0,0"/>
                        <TextBlock Text="VNĐ" Foreground="#9CAEA8" FontSize="11"/>
                    </StackPanel>
                </Border>

                <Border Background="#FFFFFF" BorderBrush="#C2D6CE" BorderThickness="1" CornerRadius="12" Padding="25" Margin="0,0,15,15" MinWidth="250">
                    <StackPanel>
                        <TextBlock Text="Sắp hết hàng" Foreground="#557A6F" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock x:Name="txtSapHet" Text="--" FontSize="32" FontWeight="Bold" Foreground="#E07A5F" Margin="0,5,0,0"/>
                        <TextBlock Text="sản phẩm tồn kho &lt; 5" Foreground="#9CAEA8" FontSize="11"/>
                    </StackPanel>
                </Border>
            </WrapPanel>

            <!-- ===== SƠ ĐỒ PHÂN LOẠI LINH KIỆN ===== -->
            <TextBlock Text="SƠ ĐỒ PHÂN LOẠI LINH KIỆN THEO DANH MỤC" FontSize="16" FontWeight="Bold" Foreground="#2C3D38" Margin="0,25,0,12"/>

            <Border Background="#FFFFFF" BorderBrush="#C2D6CE" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,15">
                <StackPanel>
                    <!-- Tiêu đề trung tâm sơ đồ -->
                    <Border Background="#2C3D38" CornerRadius="8" Padding="15,10" HorizontalAlignment="Center" Margin="0,0,0,5">
                        <TextBlock Text="CỬA HÀNG LINH KIỆN MÁY TÍNH" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                    </Border>

                    <!-- Đường nối trung tâm -->
                    <Border Width="2" Height="20" Background="#4A7C6B" HorizontalAlignment="Center"/>

                    <!-- Thanh ngang nối các nhánh -->
                    <Border Height="2" Background="#4A7C6B" Margin="40,0"/>

                    <!-- Các nhánh loại sản phẩm (sẽ được generate từ code-behind) -->
                    <ItemsControl x:Name="icLoaiSanPham" Margin="0,0,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel HorizontalAlignment="Center"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ===== BIỂU ĐỒ TỒN KHO THEO LOẠI SẢN PHẨM ===== -->
            <TextBlock Text="BIỂU ĐỒ TỒN KHO THEO LOẠI SẢN PHẨM" FontSize="16" FontWeight="Bold" Foreground="#2C3D38" Margin="0,10,0,12"/>

            <Border Background="#FFFFFF" BorderBrush="#C2D6CE" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,15">
                <StackPanel x:Name="spBieuDoTonKho">
                    <!-- Sẽ được tạo từ code-behind -->
                </StackPanel>
            </Border>

            <!-- ===== TOP SẢN PHẨM BÁN CHẠY ===== -->
            <TextBlock Text="TOP 5 SẢN PHẨM BÁN CHẠY NHẤT" FontSize="16" FontWeight="Bold" Foreground="#3A8970" Margin="0,10,0,12"/>

            <DataGrid x:Name="dgTopBanChay" AutoGenerateColumns="False" IsReadOnly="True" 
                      Background="#FFFFFF" Foreground="#2C3D38" RowBackground="#FFFFFF" 
                      AlternatingRowBackground="#F4F8F6" BorderBrush="#C2D6CE" BorderThickness="1" 
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E0EAE5" 
                      HeadersVisibility="Column" MaxHeight="250">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#3A8970"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="Padding" Value="10,8"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Hạng" Binding="{Binding Hang}" Width="60"/>
                    <DataGridTextColumn Header="Mã SP" Binding="{Binding MaSP}" Width="80"/>
                    <DataGridTextColumn Header="Tên sản phẩm" Binding="{Binding TenSP}" Width="*"/>
                    <DataGridTextColumn Header="Số lượng đã bán" Binding="{Binding TongBan}" Width="130"/>
                    <DataGridTextColumn Header="Tổng doanh thu" Binding="{Binding TongTien}" Width="150"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- ===== SẢN PHẨM SẮP HẾT HÀNG ===== -->
            <TextBlock Text="SẢN PHẨM SẮP HẾT HÀNG" FontSize="16" FontWeight="Bold" Foreground="#E07A5F" Margin="0,25,0,10"/>

            <DataGrid x:Name="dgSapHet" AutoGenerateColumns="False" IsReadOnly="True" 
                      Background="#FFFFFF" Foreground="#2C3D38" RowBackground="#FFFFFF" 
                      AlternatingRowBackground="#F4F8F6" BorderBrush="#C2D6CE" BorderThickness="1" 
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E0EAE5" 
                      HeadersVisibility="Column" MaxHeight="300">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#4A7C6B"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="Padding" Value="10,8"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Mã SP" Binding="{Binding MaSP}" Width="80"/>
                    <DataGridTextColumn Header="Tên sản phẩm" Binding="{Binding TenSP}" Width="*"/>
                    <DataGridTextColumn Header="Loại" Binding="{Binding TenLoai}" Width="120"/>
                    <DataGridTextColumn Header="Tồn kho" Binding="{Binding SoLuongTon}" Width="80"/>
                    <DataGridTextColumn Header="Giá bán" Binding="{Binding GiaBan, StringFormat='{}{0:#,##0}'}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>

        </StackPanel>
    </ScrollViewer>
</UserControl>